{
  "name": "ft_transcendence",
  "version": "0.0.0",
  "description": "This project is centered around the design, development, and organization of a full-stack web application.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "imports": {
    "#lib/*": "./build/lib/*.js"
  },
  "scripts": {
    "start": "node build",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc",
    "dev": "concurrently -p '{name}' -n 'client,server' -c 'bgMagenta.bold,bgCyan.bold' 'npm run dev:client' 'npm run dev:server'",
    "dev:c": "npm run dev:client",
    "dev:s": "npm run dev:server",
    "dev:client": "vite build -w",
    "dev:server": "nodemon -e ts -w src/server -x 'tsc && dotenvx run -- node build'",
    "lint": "eslint",
    "lint:client": "npm run lint -- src/client",
    "lint:server": "npm run lint -- src/server",
    "fix": "eslint --fix",
    "fix:client": "npm run fix -- src/client",
    "fix:server": "npm run fix -- src/server"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.43.0",
    "@eslint/js": "^9.25.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/websocket": "^11.0.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "otpauth": "^9.4.0",
    "sharp": "^0.34.1",
    "sql-template-strings": "^2.2.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
}
